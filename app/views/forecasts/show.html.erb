<!DOCTYPE html>
<html>
<head>
  <title>Weather Forecast - <%= @forecast[:location] %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }
    
    .container {
      max-width: 900px;
      margin: 0 auto;
    }
    
    .card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      padding: 40px;
      margin-bottom: 20px;
    }
    
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 15px;
    }
    
    h1 {
      color: #333;
      font-size: 28px;
    }
    
    .location {
      color: #666;
      font-size: 16px;
      margin-top: 5px;
    }
    
    .cache-badge {
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
    }
    
    .from-cache {
      background-color: #e3f2fd;
      color: #1976d2;
    }
    
    .fresh-data {
      background-color: #e8f5e9;
      color: #388e3c;
    }
    
    .current-weather {
      text-align: center;
      padding: 30px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 15px;
      color: white;
      margin-bottom: 30px;
    }
    
    .temp-display {
      font-size: 72px;
      font-weight: 300;
      margin: 20px 0;
    }
    
    .conditions {
      font-size: 24px;
      margin-bottom: 10px;
    }
    
    .temp-range {
      font-size: 18px;
      opacity: 0.9;
    }
    
    .details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
    
    .detail-item {
      padding: 20px;
      background-color: #f8f9fa;
      border-radius: 10px;
    }
    
    .detail-label {
      font-size: 14px;
      color: #666;
      margin-bottom: 5px;
    }
    
    .detail-value {
      font-size: 20px;
      font-weight: 600;
      color: #333;
    }
    
    .forecast-detailed {
      padding: 20px;
      background-color: #f8f9fa;
      border-radius: 10px;
      margin-bottom: 30px;
    }
    
    .forecast-detailed h3 {
      color: #333;
      margin-bottom: 15px;
    }
    
    .forecast-detailed p {
      color: #555;
      line-height: 1.6;
    }
    
    .extended-forecast {
      margin-top: 30px;
    }
    
    .extended-forecast h2 {
      color: #333;
      margin-bottom: 20px;
    }
    
    .forecast-items {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 15px;
    }
    
    .forecast-item {
      padding: 15px;
      background-color: #f8f9fa;
      border-radius: 10px;
      border-left: 4px solid #667eea;
    }
    
    .forecast-item-name {
      font-weight: 600;
      color: #333;
      margin-bottom: 8px;
    }
    
    .forecast-item-temp {
      font-size: 24px;
      font-weight: 600;
      color: #667eea;
      margin-bottom: 5px;
    }
    
    .forecast-item-conditions {
      color: #666;
      font-size: 14px;
    }
    
    .btn-back {
      display: inline-block;
      padding: 12px 24px;
      background: white;
      color: #667eea;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      border: 2px solid #667eea;
      transition: all 0.3s;
    }
    
    .btn-back:hover {
      background: #667eea;
      color: white;
    }
    
    .timestamp {
      text-align: center;
      color: #666;
      font-size: 14px;
      margin-top: 20px;
    }
    
    @media (max-width: 600px) {
      .temp-display {
        font-size: 48px;
      }
      
      .conditions {
        font-size: 20px;
      }
      
      .header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <div>
          <h1>🌤 Weather Forecast</h1>
          <p class="location"><%= @forecast[:location] %></p>
        </div>
        <div class="cache-badge <%= @from_cache ? 'from-cache' : 'fresh-data' %>">
          <%= @from_cache ? '📦 Cached Data' : '✨ Fresh Data' %>
        </div>
      </div>
      
      <div class="current-weather">
        <div class="conditions"><%= @forecast[:conditions] %></div>
        <div class="temp-display">
          <%= @forecast[:current_temp] %>°<%= @forecast[:temperature_unit] %>
        </div>
        <div class="temp-range">
          High: <%= @forecast[:high_temp] %>° | Low: <%= @forecast[:low_temp] %>°
        </div>
      </div>
      
      <div class="details-grid">
        <div class="detail-item">
          <div class="detail-label">Zip Code</div>
          <div class="detail-value"><%= @forecast[:zip_code] %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Wind Speed</div>
          <div class="detail-value"><%= @forecast[:wind_speed] %></div>
        </div>
        <div class="detail-item">
          <div class="detail-label">Wind Direction</div>
          <div class="detail-value"><%= @forecast[:wind_direction] %></div>
        </div>
      </div>
      
      <div class="forecast-detailed">
        <h3>Detailed Forecast</h3>
        <p><%= @forecast[:forecast_detailed] %></p>
      </div>
      
      <% if @forecast[:extended_forecast] && @forecast[:extended_forecast].any? %>
        <div class="extended-forecast">
          <h2>Extended Forecast (7 Days)</h2>
          <div class="forecast-items">
            <% @forecast[:extended_forecast].each do |period| %>
              <div class="forecast-item">
                <div class="forecast-item-name"><%= period[:name] %></div>
                <div class="forecast-item-temp">
                  <%= period[:temperature] %>°<%= period[:temperature_unit] %>
                </div>
                <div class="forecast-item-conditions"><%= period[:conditions] %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <div class="timestamp">
        <% if @from_cache %>
          ℹ️ This data was retrieved from cache. Cache expires in 30 minutes from first request.
        <% else %>
          ℹ️ This data has been cached for 30 minutes for zip code <%= @forecast[:zip_code] %>.
        <% end %>
        <br>
        Last updated: <%= @forecast[:timestamp].strftime('%B %d, %Y at %I:%M %p') %>
      </div>
    </div>
    
    <%= link_to '← Search Another Location', new_forecast_path, class: 'btn-back' %>
  </div>
</body>
</html>
